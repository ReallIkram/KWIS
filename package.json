{
  "name": "kwis",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "npm run seed -w server",
    "admin:create": "npm run admin:create -w server",
    "test:e2e": "playwright test",
    "db:dev": "npm run db:dev -w server",
    "dev:local": "concurrently -k \"npm run db:dev\" \"npm run dev\"",
    "test:db": "RUN_DB_TESTS=1 npm run test -w server -- src/integration.test.ts",
    "db:prepare": "npm run db:prepare -w server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=22.12 <26"
  }
}
