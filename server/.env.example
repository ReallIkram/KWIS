NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/kwis
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=
COOKIE_SAME_SITE=lax
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
PUBLIC_SITE_URL=https://reallikram.github.io/KWIS/
# Set true to serve client/dist at /KWIS/ on the backend host (same-origin admin).
SERVE_CLIENT=false
# Set only to the exact trusted reverse proxy hop count supplied by your host.
TRUST_PROXY_HOPS=
# Backend-hosted UI base for password reset emails, e.g. https://your-api.example/KWIS
ADMIN_SITE_URL=
